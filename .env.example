OPENAI_BASE_URL=http://192.168.3.101:3001/v1
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=auto

# RabbitMQ（默认开启；RabbitMQ 不可用时 ItemNest 仍可正常使用 SQLite）
ITEMNEST_RABBITMQ_ENABLED=1
ITEMNEST_RABBITMQ_URL=amqp://guest:guest@127.0.0.1/
ITEMNEST_RABBITMQ_EXCHANGE=itemnest.events
ITEMNEST_RABBITMQ_QUEUE=itemnest.inventory.events
