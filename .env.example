# 数据目录（start.bat/start.sh 会自动指向项目根目录的 data）
ITEMNEST_DATA_DIR=./data

# 默认仅监听本机。确实需要局域网访问时改为 0.0.0.0。
ITEMNEST_BIND_ADDRESS=127.0.0.1

# OpenAI 兼容接口。也支持 ITEMNEST_AI_BASE_URL / ITEMNEST_AI_API_KEY / ITEMNEST_AI_MODEL。
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=auto

# RabbitMQ：SQLite 主功能不依赖 MQ，默认关闭；需要事件总线时再开启。
ITEMNEST_RABBITMQ_ENABLED=false
ITEMNEST_RABBITMQ_URL=amqp://guest:guest@127.0.0.1/
ITEMNEST_RABBITMQ_EXCHANGE=itemnest.events
ITEMNEST_RABBITMQ_QUEUE=itemnest.inventory.events
ITEMNEST_RABBITMQ_WORKER_ENABLED=false
