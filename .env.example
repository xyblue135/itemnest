# 数据目录（start.bat/start.sh 会自动指向项目根目录的 data）
ITEMNEST_DATA_DIR=./data

OPENAI_BASE_URL=http://192.168.3.101:3001/v1
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=auto

# RabbitMQ：不可用时 SQLite 主功能仍可正常使用
ITEMNEST_RABBITMQ_ENABLED=true
ITEMNEST_RABBITMQ_URL=amqp://guest:guest@127.0.0.1/
ITEMNEST_RABBITMQ_EXCHANGE=itemnest.events
ITEMNEST_RABBITMQ_QUEUE=itemnest.inventory.events
ITEMNEST_RABBITMQ_WORKER_ENABLED=false
